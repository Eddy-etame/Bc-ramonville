# ─────────────────────────────────────────────────────────────
# Boxing Center — variables d'environnement (Vercel → Settings → Environment Variables)
# TOUTES sont optionnelles : sans elles le site fonctionne, en mode dégradé honnête.
# Copie ce fichier en .env pour du local. NE COMMITE JAMAIS .env.
# ─────────────────────────────────────────────────────────────

# ── Le backoffice « Le vestiaire » (/admin/) ──
# Le mot de passe du staff. Sans lui, l'admin refuse toute connexion.
ADMIN_TOKEN=

# ── L'assistant (chatbot IA) ──
# Au moins UNE clé pour des réponses IA. Sans aucune, l'assistant répond
# quand même via sa base locale ancrée (jamais de bulle vide).
# GEMINI est lu en POOL : tu peux ajouter GEMINI_API_KEY_2, _3, … pour répartir le quota.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Les contacts collectés par l'assistant ──
# Option A — le registre relisible dans le vestiaire (recommandé) :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option B — un e-mail au staff à chaque contact :
RESEND_API_KEY=
LEAD_TO=boxingcenter31@gmail.com
LEAD_FROM=
# Option C — un webhook (Make, Zapier, n8n…) :
LEAD_WEBHOOK_URL=
# Sans aucune option, les contacts sont journalisés dans les logs Vercel (rien n'est perdu).

# ── Publication depuis le vestiaire (bouton « Publier ») ──
# Le backoffice commite le contenu sur GitHub puis redéclenche le déploiement.
GITHUB_TOKEN=
GITHUB_REPO=Eddy-etame/Bc-ramonville
GITHUB_BRANCH=main
VERCEL_DEPLOY_HOOK=
