# ─────────────────────────────────────────────────────────────
# Boxing Center — variables d'environnement (Vercel → Settings → Environment Variables)
# TOUTES sont optionnelles : sans elles le site fonctionne, en mode dégradé honnête.
# Copie ce fichier en .env pour du local. NE COMMITE JAMAIS .env.
# ─────────────────────────────────────────────────────────────

# ── Le backoffice « Le vestiaire » (/admin/) ──
# Le mot de passe du staff. Sans lui, l'admin refuse toute connexion.
ADMIN_TOKEN=

# ── L'assistant (chatbot IA) ──
# Au moins UNE clé pour des réponses IA. Sans aucune, l'assistant répond
# quand même via sa base locale ancrée (jamais de bulle vide).
# GEMINI est lu en POOL : tu peux ajouter GEMINI_API_KEY_2, _3, … pour répartir le quota.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Les contacts collectés par l'assistant ──
# Option A — le registre relisible dans le vestiaire (recommandé) :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option B — un e-mail au staff à chaque contact :
RESEND_API_KEY=
LEAD_TO=boxingcenter31@gmail.com
LEAD_FROM=
# Option C — un webhook (Make, Zapier, n8n…) :
LEAD_WEBHOOK_URL=
# Sans aucune option, les contacts sont journalisés dans les logs Vercel (rien n'est perdu).

# ── La galerie du club (dépôts des visiteurs sur /galerie/) ──
# Le stockage des photos et vidéos déposées par les visiteurs. C'est le MÊME
# service que Portet — Cloudinary stocke, transcode, sert, et ses tags font
# office de base (pending → approved). Une seule variable à coller, elle
# contient tout : Cloudinary → Dashboard → « API Environment variable ».
# SANS ELLE, RIEN NE CASSE : la section reste sur le site avec un message
# d'attente honnête, et Le vestiaire dit qu'elle n'est pas branchée.
CLOUDINARY_URL=
# Le dossier de CETTE salle. Deux salles peuvent partager un compte Cloudinary
# sans jamais mélanger leurs murs ni leurs files de modération.
COMMUNITY_FOLDER=bc-ramonville-community
# Les limites, appliquées côté navigateur ET revérifiées côté serveur sur le
# fichier réel (api/community/check.js). Laisse vide pour les valeurs par défaut.
COMMUNITY_MAX_PHOTO_MO=12
COMMUNITY_MAX_VIDEO_MO=80
COMMUNITY_MAX_SEC=15
# Débit par visiteur : au plus 3 fichiers par tranche de 10 minutes.
COMMUNITY_MAX_PAR_FENETRE=3
COMMUNITY_FENETRE_MIN=10
# Le coup d'œil automatique sur les photos réutilise GEMINI_API_KEY ci-dessus.
# Sans clé, aucun tri automatique : tout part en file de modération humaine.

# ── Publication depuis le vestiaire (bouton « Publier ») ──
# Le backoffice commite le contenu sur GitHub puis redéclenche le déploiement.
GITHUB_TOKEN=
GITHUB_REPO=Eddy-etame/Bc-ramonville
GITHUB_BRANCH=main
VERCEL_DEPLOY_HOOK=
