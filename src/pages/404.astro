<!doctype html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page introuvable — Boxing Center Ramonville</title>
  <meta name="robots" content="noindex, follow" />

  <!-- Préconnexions — avant toute feuille de style -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="preconnect" href="https://api.open-meteo.com" crossorigin />

  <!-- Polices AUTO-HÉBERGÉES — mêmes familles/graisses que l'original Google Fonts -->
  <link rel="preload" href="/fonts/chakrapetch-700-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/manrope-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=8" />
  <link rel="stylesheet" href="/assets/css/base.css?v=8" />
  <link rel="stylesheet" href="/assets/css/page.css?v=8" />

  <meta name="theme-color" content="#070a12" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=8" />
  <meta name="twitter:card" content="summary" />
  <style is:inline>
    /* Le 404 n'est plus un cul-de-sac : sous le message, les huit côtés de
       l'octogone sont là, cliquables. Un visiteur perdu atterrit sur une
       navigation, pas sur deux boutons et une impasse. */
    .e404 { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; overflow: hidden; background: var(--void); padding: clamp(6rem,14vh,9rem) var(--gut) clamp(3rem,7vh,5rem); }
    .e404__inner { position: relative; z-index: 2; width: min(92vw, 1280px); margin-inline: auto; }
    .e404__head { max-width: 54ch; }
    .e404__code { font-family: var(--f-display); font-weight: 700; font-size: clamp(4rem,18vw,9rem); letter-spacing: -.03em; line-height: .9; background: var(--uv); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .e404 h1 { font-family: var(--f-display); font-weight: 700; text-transform: uppercase; font-size: clamp(1.6rem,4vw,2.6rem); margin: 1rem 0 .8rem; color: var(--ink); }
    .e404 p { color: var(--ink-soft); margin-bottom: 1.8rem; }
    .e404__cta { display: inline-flex; gap: .8rem; flex-wrap: wrap; }
    .e404__label { font: 600 var(--step--1)/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin: clamp(2.4rem,6vh,3.6rem) 0 1rem; display: block; }
    .e404__edges { display: grid; gap: 1px; grid-template-columns: repeat(2,1fr); background: var(--line-soft); border: 1px solid var(--line); }
    @media (min-width: 720px){ .e404__edges { grid-template-columns: repeat(4,1fr); } }
    .e404__edge { background: color-mix(in srgb, var(--paper-2) 72%, transparent); padding: clamp(.9rem,2vw,1.3rem); display: flex; flex-direction: column; gap: .3rem; min-height: 5.4rem; transition: background .3s, color .3s; }
    .e404__edge:hover { background: var(--paper-2); }
    .e404__edge b { font-family: var(--f-display); font-weight: 700; text-transform: uppercase; font-size: 1.05rem; color: var(--ink); line-height: 1.1; transition: color .3s; }
    .e404__edge:hover b { color: var(--accent); }
    .e404__edge span { font: 600 var(--step--2)/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
    @media (hover: none) { .e404__edge { min-height: 44px; } .e404__edge:active b { color: var(--accent); } }
  </style>
  <script is:inline>
    (function(){try{var p=localStorage.getItem('bc-ram-palette');if(p==='cuivre')document.documentElement.setAttribute('data-palette','cuivre');}catch(e){}})();
  </script>
</head>
<body data-page="404">
  <!-- le saut au contenu manquait ICI seulement, sur les 9 pages : le clavier
       n'avait aucun moyen de sauter la nav, et <main> n'avait pas de cible. -->
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main class="e404" id="main">
    <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div><div class="sky__moon"></div></div>
    <div class="e404__inner">
      <div class="e404__head">
        <div class="e404__code">404</div>
        <h1>Hors du plateau</h1>
        <p>Ce côté de l'octogone n'existe pas. Les huit autres, si — ils sont juste en dessous.</p>
        <div class="e404__cta">
          <a class="btn btn--primary" data-magnetic href="/"><span>Retour à l'accueil</span></a>
          <a class="btn btn--ghost" data-magnetic href="/plannings/"><span>Voir le planning</span></a>
        </div>
      </div>
      <span class="e404__label">Les huit côtés</span>
      <nav class="e404__edges" id="e404-edges" aria-label="Les huit disciplines"></nav>
    </div>
  </main>

  <div id="footer"></div>

  <a class="chatbot" href="tel:+33562244682" aria-label="Une question ? Appelle la salle Boxing Center Ramonville">
    <span class="chatbot__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
    <span class="chatbot__label">Une question&nbsp;? Appelle la salle</span>
  </a>

  <script is:inline defer src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  <script is:inline type="module" src="/assets/js/site.js?v=8"></script>
  <script is:inline type="module" src="/assets/js/sky.js?v=8"></script>

  <!-- Les huit côtés, depuis la source de vérité — un 404 qui renvoie
       quelque part vaut mieux qu'un 404 qui s'excuse. -->
  <script is:inline type="module">
    import { DISCIPLINES } from "/assets/js/data.js?v=8";
    const box = document.getElementById("e404-edges");
    if (box && DISCIPLINES) {
      box.innerHTML = [...DISCIPLINES].sort((a, b) => a.edge - b.edge).map((d) =>
        `<a class="e404__edge" href="/activites/#${d.key}"><b>${d.name}</b><span>${d.tag}</span></a>`).join("");
      window.BC?.magnetic(document);
    }
  </script>
</body>
</html>
