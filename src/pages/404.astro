  <title>Page introuvable | Boxing Center Ramonville</title>
  <meta name="robots" content="noindex, follow" />

  <!-- Préconnexions — avant toute feuille de style -->
  <link rel="preconnect" href="https://api.open-meteo.com" crossorigin />

  <!-- Polices AUTO-HÉBERGÉES — mêmes familles/graisses que l’original Google Fonts -->
  <link rel="preload" href="/fonts/chakrapetch-700-latin.woff2?v=19" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/manrope-var-latin.woff2?v=19" as="font" type="font/woff2" crossorigin />
  <!-- JetBrains Mono manquait à l’appel, et c’est LUI qui décalait la page.
       Les libellés mono sont partout au-dessus de la ligne de flottaison —
       fil d’ariane, sur-titres, boutons, les chips du hero. La police
       arrivait après le premier rendu : tout ce petit monde changeait de
       largeur d’un coup et poussait la première section vers le bas
       (0,621 de décalage mesuré sur /tarifs/). Elle était de toute façon
       téléchargée sur les huit pages : la précharger ne coûte pas un octet
       ni une requête de plus, elle arrive seulement à l’heure. -->
  <link rel="preload" href="/fonts/jetbrainsmono-var-latin.woff2?v=19" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=19" />
  <link rel="stylesheet" href="/assets/css/base.css?v=23" />
  <link rel="stylesheet" href="/assets/css/page.css?v=19" />

  <meta name="theme-color" content="#070a12" />
