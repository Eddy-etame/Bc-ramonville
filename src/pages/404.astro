  <link rel="apple-touch-icon" href="/apple-touch-icon.png?i=2" sizes="180x180" />
  <meta name="twitter:card" content="summary" />
  <style is:inline>
    /* Le 404 n’est plus un cul-de-sac : sous le message, les huit côtés de
       l’octogone sont là, cliquables. Un visiteur perdu atterrit sur une
       navigation, pas sur deux boutons et une impasse. */
    .e404 { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; overflow: hidden; background: var(--void); padding: clamp(6rem,14vh,9rem) var(--gut) clamp(3rem,7vh,5rem); }
    .e404__inner { position: relative; z-index: 2; width: min(92vw, 1280px); margin-inline: auto; }
    .e404__head { max-width: 54ch; }
    .e404__code { font-family: var(--f-display); font-weight: 700; font-size: clamp(4rem,18vw,9rem); letter-spacing: -.03em; line-height: .9; background: var(--uv); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .e404 h1 { font-family: var(--f-display); font-weight: 700; text-transform: uppercase; font-size: clamp(1.6rem,4vw,2.6rem); margin: 1rem 0 .8rem; color: var(--ink); }
    .e404 p { color: var(--ink-soft); margin-bottom: 1.8rem; }
    .e404__cta { display: inline-flex; gap: .8rem; flex-wrap: wrap; }
    .e404__label { font: 600 var(--step--1)/1 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin: clamp(2.4rem,6vh,3.6rem) 0 1rem; display: block; }
    .e404__edges { display: grid; gap: 1px; grid-template-columns: repeat(2,1fr); background: var(--line-soft); border: 1px solid var(--line); }
    @media (min-width: 720px){ .e404__edges { grid-template-columns: repeat(4,1fr); } }
    .e404__edge { background: color-mix(in srgb, var(--paper-2) 72%, transparent); padding: clamp(.9rem,2vw,1.3rem); display: flex; flex-direction: column; gap: .3rem; min-height: 5.4rem; transition: background .3s, color .3s; }
    .e404__edge:hover { background: var(--paper-2); }
    .e404__edge b { font-family: var(--f-display); font-weight: 700; text-transform: uppercase; font-size: 1.05rem; color: var(--ink); line-height: 1.1; transition: color .3s; }
    .e404__edge:hover b { color: var(--accent); }
    .e404__edge span { font: 600 var(--step--2)/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
    @media (hover: none) { .e404__edge { min-height: 44px; } .e404__edge:active b { color: var(--accent); } }
  </style>
  <!-- LA COULEUR NE SE NÉGOCIE PLUS : l’argent de la marque est le seul état.
       Ce <head> lisait localStorage avant le premier paint pour restituer une
       bascule Acier/Cuivre qui vient d’être retirée de la barre — il ne restait
       qu’un accès disque bloquant devant le rendu, pour rien.
       Rien n’a besoin de tourner ici avant le rendu sur cette page. -->
  <!-- LES TROIS LIBS SONT MAINTENANT CHEZ NOUS (/assets/vendor/).
       Elles arrivaient de cdn.jsdelivr.net : un second domaine à résoudre, une
       seconde poignée de main TLS, avant la moindre ligne d’animation — et ça
       sur les huit pages. Mesure brotli en main, le CDN les servait gzippées
       (51,2 ko) ; servies d’ici elles pèsent 43,3 ko, se mettent en cache un an
       comme tout /assets/, et surtout script-src a pu se refermer sur 'self'
       dans vercel.json. `defer` inchangé : elles ne retiennent pas le rendu et
       s’exécutent dans l’ordre du document, donc avant les modules du pied. -->
  <script is:inline defer src="/assets/vendor/gsap.min.js?v=19"></script>
  <script is:inline defer src="/assets/vendor/ScrollTrigger.min.js?v=19"></script>
  <script is:inline defer src="/assets/vendor/lenis.min.js?v=19"></script>
  <!-- LES AUTEURS DU SITE, en donnees structurees.
       schema.org `creator` sur le noeud WebSite : c'est le canal que Google et
       les crawlers d'IA lisent pour attribuer un site. `sameAs` relie chaque
       personne a ses profils publics, ce qui permet de la reconnaitre.
       Servi dans le HTML statique — le credit precedent etait ecrit par
       JavaScript et n'atteignait donc aucun robot d'IA. -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://mmatoulouse.com/#website",
    "url": "https://mmatoulouse.com/",
    "name": "Boxing Center Ramonville",
    "inLanguage": "fr-FR",
    "creator": {
      "@type": "Person",
      "name": "Angoula Onambele Germain Raphael",
      "sameAs": ["https://fr.linkedin.com/in/germain-raphael-angoula-onambele-a6b858395"]
    },
    "author": {
      "@type": "Person",
      "name": "Angoula Onambele Germain Raphael"
    },
    "publisher": { "@type": "Organization", "name": "Boxing Center Ramonville" },
    "mainEntityOfPage": "https://mmatoulouse.com/credits/"
  }
  </script>
</head>
<body data-page="404">
