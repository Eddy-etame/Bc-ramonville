<!doctype html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page introuvable — Boxing Center Ramonville</title>
  <meta name="robots" content="noindex, follow" />
  <meta name="theme-color" content="#070a12" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=6" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/base.css?v=6" />
  <link rel="stylesheet" href="/assets/css/page.css?v=6" />
  <style is:inline>
    .e404 { position: relative; min-height: 100svh; display: grid; place-items: center; text-align: center; overflow: hidden; background: var(--void); padding: 6rem var(--gut) 4rem; }
    .e404__inner { position: relative; z-index: 2; width: min(92vw, 54ch); }
    .e404__code { font-family: var(--f-display); font-weight: 700; font-size: clamp(4rem,18vw,9rem); letter-spacing: -.03em; line-height: .9; background: var(--uv); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .e404 h1 { font-family: var(--f-display); font-weight: 700; text-transform: uppercase; font-size: clamp(1.6rem,4vw,2.6rem); margin: 1rem 0 .8rem; color: var(--ink); }
    .e404 p { color: var(--ink-soft); margin-bottom: 1.8rem; }
    .e404__cta { display: inline-flex; gap: .8rem; flex-wrap: wrap; justify-content: center; }
  </style>
  <script is:inline>
    (function(){try{var p=localStorage.getItem('bc-ram-palette');if(p==='cuivre')document.documentElement.setAttribute('data-palette','cuivre');}catch(e){}})();
  </script>
</head>
<body data-page="404">
  <div id="nav"></div>
  <div id="drawer"></div>

  <main class="e404">
    <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div><div class="sky__moon"></div></div>
    <div class="e404__inner">
      <div class="e404__code">404</div>
      <h1>Hors du plateau</h1>
      <p>Ce côté de l'octogone n'existe pas. Reviens sous le ciel : la cage, le ring et le planning t'attendent.</p>
      <div class="e404__cta">
        <a class="btn btn--primary" data-magnetic href="/"><span>Retour à l'accueil</span></a>
        <a class="btn btn--ghost" data-magnetic href="/plannings/"><span>Voir le planning</span></a>
      </div>
    </div>
  </main>

  <div id="footer"></div>

  <a class="chatbot" href="tel:+33562244682" aria-label="Une question ? Appelle la salle Boxing Center Ramonville">
    <span class="chatbot__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
    <span class="chatbot__label">Une question&nbsp;? Appelle la salle</span>
  </a>

  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  <script is:inline type="module" src="/assets/js/site.js?v=6"></script>
  <script is:inline type="module" src="/assets/js/sky.js?v=6"></script>
</body>
</html>
