      </div>
      <span class="e404__label">Les huit cours</span>
      <nav class="e404__edges" id="e404-edges" aria-label="Les huit cours"></nav>
      <!-- Les huit cotes ci-dessus sont rendus en JS : sans lui, l'impasse
           revenait. Ces reperes-ci sont dans le HTML — un agent (ou un
           navigateur sans script) repart toujours quelque part. -->
      <span class="e404__label">Repères</span>
      <nav class="e404__edges e404__pages" aria-label="Pages principales">
        <a class="e404__edge" href="/"><b>Accueil</b><span>la salle en une page</span></a>
        <a class="e404__edge" href="/activites/"><b>Activités</b><span>les 8 disciplines</span></a>
