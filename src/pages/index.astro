  <main id="main">

    <!-- ============================ HERO ============================ -->
    <header class="hero" aria-label="Boxing Center Ramonville — l'octogone à ciel ouvert">
      <div class="sky" aria-hidden="true">
        <canvas class="sky__stars"></canvas>
        <div class="sky__haze"></div>
        <div class="sky__moon"></div>
      </div>
      <div class="wrap hero__grid">
        <div>
          <p class="eyebrow" data-reveal>Ramonville-Saint-Agne · sud toulousain</p>
          <h1 class="display hero__title">
            <span class="reveal-mask"><span class="l1">L'octogone</span></span>
            <span class="reveal-mask"><span class="tint">à ciel ouvert.</span></span>
          </h1>
          <p class="lead hero__sub" data-reveal><b>La seule salle du réseau qui s'entraîne dehors.</b> 300 m² extérieurs couverts, un octogone de 7 m, un ring olympique — la nuit, l'air, le ciel réel au-dessus de la cage.</p>
          <div class="hero__badges" data-reveal>
            <span>300 m² dehors</span>
            <span>Octogone 7 m</span>
            <span>Métro B · Ramonville</span>
            <span>Dès 3 ans</span>
          </div>
          <div class="hero__cta" data-reveal>
            <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Ma 1<sup>re</sup> séance · 10€</span></a>
            <a class="btn btn--ghost" data-magnetic href="#onav"><span>Choisir ma discipline</span></a>
          </div>
        </div>
        <div class="hero__octa" data-reveal>
          <div id="octa" aria-hidden="false"></div>
          <span class="hero__cap mono" id="hero-cap">plateau extérieur</span>
        </div>
      </div>
      <div class="wrap">
        <div class="hero__stats" id="stats" data-reveal-group aria-label="Le plateau en chiffres"></div>
      </div>
    </header>

    <!-- ========================= TICKER =========================== -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track" id="marquee"></div>
    </div>

    <!-- ==================== MANIFESTO — une ligne ================== -->
    <section class="manifesto" aria-label="Le manifeste">
      <div class="wrap">
        <p><span class="reveal-mask"><span>21h. Quatorze degrés.</span></span><span class="reveal-mask"><span class="tint">Personne n'est rentré.</span></span></p>
      </div>
    </section>

    <!-- ============= LE CLAIM EXTÉRIEUR — 300 m² dehors ============ -->
    <!-- Le claim du dehors n'est PAS illustré par une photo : les 6 clichés
         prouvés de la salle sont tous pris sous charpente. Il est illustré par
         le VRAI ciel de Ramonville (gradient piloté par Open-Meteo via sky.js,
         sans canvas ici → zéro rAF de plus) + les conditions réelles, à la
         seconde. C'est le seul fond que personne d'autre ne peut copier. -->
    <section class="claim" aria-label="300 m² d'entraînement en extérieur">
      <div class="sky claim__sky" aria-hidden="true">
        <div class="sky__haze"></div>
        <div class="sky__moon"></div>
      </div>
      <div class="wrap">
        <div class="claim__grid">
          <div>
            <span class="eyebrow" data-reveal>Rien qu'ici</span>
            <h2 class="display"><span class="reveal-mask"><span>300 m²</span></span><span class="reveal-mask"><span class="tint">dehors.</span></span></h2>
            <p class="lead claim__lead" data-reveal>Aménagés, protégés des intempéries, ouverts toute l'année. Personne d'autre dans le réseau n'a ça : on s'entraîne à l'air, sous le ciel de Ramonville, le soir venu, quand le bruit des pattes d'ours porte dans le noir.</p>
            <p class="claim__live" id="claim-live" data-reveal></p>
          </div>
          <div class="claim__figs" data-reveal-group>
            <div class="claim__fig"><b>300 m²</b><span>extérieur couvert</span></div>
            <div class="claim__fig"><b>7 m</b><span>l'octogone</span></div>
            <div class="claim__fig"><b>2</b><span>niveaux · muscu/cardio</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- =============== L'OCTOGONE-NAV — 8 arêtes → disciplines ====== -->
    <section class="section onav" id="onav" aria-label="Les disciplines par l'octogone">
      <div class="wrap">
        <div class="onav__grid">
          <div class="onav__stage" data-reveal>
            <div class="onav__filaire" id="octa-motif" aria-hidden="true">
              <svg viewBox="0 0 200 200"><path class="m-out" d="M65.6 16.8 L134.4 16.8 L183.2 65.6 L183.2 134.4 L134.4 183.2 L65.6 183.2 L16.8 134.4 L16.8 65.6 Z"/><g transform="translate(100 100) scale(.58) translate(-100 -100)"><path class="m-in" d="M65.6 16.8 L134.4 16.8 L183.2 65.6 L183.2 134.4 L134.4 183.2 L65.6 183.2 L16.8 134.4 L16.8 65.6 Z"/></g><line class="m-spoke" x1="100" y1="100" x2="65.6" y2="16.8"/><line class="m-spoke" x1="100" y1="100" x2="134.4" y2="16.8"/><line class="m-spoke" x1="100" y1="100" x2="183.2" y2="65.6"/><line class="m-spoke" x1="100" y1="100" x2="183.2" y2="134.4"/><line class="m-spoke" x1="100" y1="100" x2="134.4" y2="183.2"/><line class="m-spoke" x1="100" y1="100" x2="65.6" y2="183.2"/><line class="m-spoke" x1="100" y1="100" x2="16.8" y2="134.4"/><line class="m-spoke" x1="100" y1="100" x2="16.8" y2="65.6"/></svg>
            </div>
          </div>
          <div>
            <span class="eyebrow" data-reveal>L'instrument</span>
            <h2 class="display onav__title"><span class="reveal-mask"><span>Chaque côté de la cage ouvre un cours.</span></span></h2>
            <p class="muted" data-reveal style="max-width:42ch;margin-top:.9rem">Chaque côté de l'octogone ouvre sa discipline, ses créneaux, son coach. Fais tourner l'instrument en haut de page, ou choisis dans la liste — tout vient du planning officiel de la rentrée.</p>
            <div class="octa-legend" id="octa-legend" data-reveal-group style="margin-top:clamp(1.4rem,3vw,2rem)"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== LA BANDE STAFF ========================= -->
    <section class="section" aria-label="L'encadrement">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">Quatre, pas quarante</span>
          <h2 class="display"><span class="reveal-mask"><span>Les mains</span></span><span class="reveal-mask"><span class="tint">qui corrigent.</span></span></h2>
        </div>
        <div class="staff" id="staff" data-reveal-group></div>
      </div>
    </section>

    <!-- ==================== LA CARTE ESSAI 10€ ===================== -->
    <section class="essai" aria-label="La séance d'essai">
      <div class="wrap">
        <div class="essai__card" data-reveal>
          <div class="essai__grid">
            <div>
              <span class="eyebrow">Ta première fois</span>
              <h2 class="display" style="margin-top:.8rem"><span class="reveal-mask"><span>Viens voir</span></span><span class="reveal-mask"><span class="tint">le dehors.</span></span></h2>
              <p>Tu émarges, tu montes sur le plateau, tu tapes. Le reste, on en parle après la séance.</p>
              <ul>
                <li>Toutes les disciplines, un seul essai</li>
                <li>Gants, bandes, tout est prêté</li>
                <li>Sans engagement, sans discours</li>
              </ul>
              <div class="essai__cta">
                <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver l'essai · 10€</span></a>
                <a class="btn btn--ghost" data-magnetic href="/plannings/"><span>Voir le planning</span></a>
              </div>
            </div>
            <div class="essai__price">10€<small>la séance</small></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================= GONG NUIT ========================= -->
    <section class="gong" aria-label="Rejoindre la salle">
      <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div></div>
      <div class="gong__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>Le soir tombe sur le plateau</span>
        <h2 class="display"><span class="reveal-mask"><span>La cage est ouverte.</span></span><span class="reveal-mask"><span class="tint">Le ciel aussi.</span></span></h2>
        <p class="lead" data-reveal>33 rue des Ormes, Ramonville-Saint-Agne. Métro B, terminus Ramonville. Lun–sam, 10h–21h30.</p>
        <div class="gong__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver ma 1<sup>re</sup> séance</span></a>
          <a class="btn btn--ghost" data-magnetic href="tel:+33562244682"><span>05 62 24 46 82</span></a>
        </div>
      </div>
    </section>

  </main>

