---
/* UNE SEULE SOURCE POUR LES CHIFFRES DU HERO.
   data.js est le registre des faits de la salle : le navigateur le lit à
   l’exécution, le build le lit ici. Le fichier est pur (aucun `window`,
   aucun `document` au chargement) — il s’importe donc des deux côtés sans
   rien casser. Si les 300 m² changent un jour, ils changent à un endroit. */
import { STATS, LIEU, HOME_FAQ, SEMAINE, REVIEWS, NETWORK, SALLE } from "../../public/assets/js/data.js";
const nf = new Intl.NumberFormat("fr-FR");
/* Les ajouts de l’accueil (08/10/2026) lisent les MÊMES faits que le reste
   du site : la visite, la semaine, les questions, les avis, le réseau. */
const FAQ_LD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://mmatoulouse.com/#faq",
  mainEntity: HOME_FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
});
const SOEURS = NETWORK.filter((n) => !n.self);
const CAMP_SAMEDI = SEMAINE.find((j) => j.d === "Sam")?.cours.find((c) => c.disc === "boxing-camp");
const img = (f) => `/assets/img/ram/photos/${f}-boxing-center-ramonville`;
const ACCES = SALLE.access.map((a) => { const [t, ...d] = a.split(" — "); return { t, d: d.join(" — ") }; });
