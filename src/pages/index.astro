<body data-page="home">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">

    <!-- ============================ HERO ============================ -->
    <header class="hero" aria-label="Boxing Center Ramonville — un club ouvert à tous">
      <div class="sky" aria-hidden="true">
        <canvas class="sky__stars"></canvas>
        <div class="sky__haze"></div>
        <div class="sky__moon"></div>
      </div>
      <div class="wrap hero__grid">
        <div>
          <p class="eyebrow" data-reveal>Ramonville-Saint-Agne · sud toulousain</p>
          <h1 class="display hero__title">
            <span class="reveal-mask"><span class="l1">Boxing Center</span></span>
            <span class="reveal-mask"><span class="l2 tint">Ramonville</span></span>
            <!-- Suite du titre, lue par Google et les lecteurs d’écran. -->
            <span class="sr-only"> — club de boxe et de MMA au terminus du métro B. Cours tous niveaux dès 3 ans.</span>
          </h1>
          <div class="hero__cta" data-reveal>
            <a class="btn btn--primary" data-magnetic href="https://boutique.boxingcenter.fr/inscription?product=offre-duo&step=1&utm_source=site&utm_medium=cta&utm_campaign=bc-ramonville"><span>Je profite de l'offre — 29 €</span></a>
            <a class="btn btn--ghost" data-magnetic href="#onav"><span>Voir les cours</span></a>
          </div>
          <p data-reveal class="offre__detail">29&nbsp;€ par personne · 4 semaines · gants et bandes prêtés</p>
        </div>
        <div class="hero__octa" data-reveal>
          <div id="octa" aria-hidden="false"></div>
          <span class="hero__cap mono" id="hero-cap">dehors, à l’abri</span>
        </div>
      </div>
      <div class="wrap">
        <!-- LES QUATRE CHIFFRES SONT DANS LE HTML, PAS SEULEMENT DANS LE JS.
             Deux raisons, mesurées toutes les deux :
             · le décalage. Ce bloc arrivait vide puis se remplissait, et le
               hero grandissait de 143 px sous les pieds du visiteur — 0,132
               de CLS, le seul saut de mise en page du site, et il tombait
               pile sur le premier écran.
             · le référencement. Sept mètres d’octogone, 300 m² dehors, deux
               niveaux, six jours sur sept : les quatre faits qui vendent la
               salle n’existaient que pour un robot qui exécute le JavaScript.
             La source reste STATS dans data.js — c’est le même tableau, lu
             au build. renderStats() voit le bloc déjà rempli et ne le
             reconstruit pas ; le compteur, lui, anime les nœuds en place. -->
        <div class="hero__stats" id="stats" data-reveal-group aria-label="Le plateau en chiffres">
          {STATS.map((s) => (
            <div class="stat">
              <div class="stat__v">
                <span data-count={String(s.v)} data-raw={s.raw ? "" : undefined} set:html={nf.format(s.v)} />
                {s.suffix ? <sup>{s.suffix.trim()}</sup> : null}
              </div>
              <div class="stat__l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </header>

    <!-- ========================= TICKER =========================== -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track" id="marquee"></div>
    </div>

    <!-- ==================== MANIFESTO — une ligne ==================
         Cette ligne disait « 21h. Quatorze degrés. » — une heure et une
         température ÉCRITES EN DUR, dans un registre documentaire, sur une
         page qui affiche deux sections plus bas le vrai relevé Open-Meteo
         au-dessus de la salle. Les deux se contredisaient à l’écran (« CIEL
         VOILÉ · 31°C · 12H » face à « 21h. Quatorze degrés. ») et le manifeste
         avait tort environ vingt-trois heures sur vingt-quatre.
         Un relevé fabriqué n’a pas sa place sur ce site : la ligne ne porte
         donc plus aucun chiffre. Le seul endroit de la page qui date et qui
         mesure est celui qui lit le ciel réel — #claim-live, plus bas. -->
    <section class="manifesto" aria-label="Le manifeste">
      <div class="wrap">
        <p><span class="reveal-mask"><span>Ici, tout le monde</span></span><span class="reveal-mask"><span class="tint">peut commencer.</span></span></p>
      </div>
    </section>

    <!-- ============= LE CLAIM EXTÉRIEUR — 300 m² dehors ============ -->
    <!-- Le claim du dehors n’est PAS illustré par une photo : les 6 clichés
         prouvés de la salle sont tous pris sous charpente. Il est illustré par
         le VRAI ciel de Ramonville (gradient piloté par Open-Meteo via sky.js,
         sans canvas ici → zéro rAF de plus) + les conditions réelles, à la
         seconde. C’est le seul fond que personne d’autre ne peut copier. -->
    <section class="claim" aria-label="300 m² d’entraînement en extérieur">
      <div class="sky claim__sky" aria-hidden="true">
        <div class="sky__haze"></div>
        <div class="sky__moon"></div>
      </div>
      <div class="wrap">
        <div class="claim__grid">
          <div>
            <span class="eyebrow" data-reveal>Le club</span>
            <h2 class="display"><span class="reveal-mask"><span>300 m²</span></span><span class="reveal-mask"><span class="tint">dehors.</span></span></h2>
            <p class="claim__live" id="claim-live" data-reveal></p>
          </div>
          <div class="claim__figs" data-reveal-group>
            <div class="claim__fig"><b>300 m²</b><span>couverts</span></div>
            <div class="claim__fig"><b>7 m</b><span>l’octogone</span></div>
            <div class="claim__fig"><b>2</b><span>niveaux · muscu/cardio</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- =============== L’OCTOGONE-NAV — 8 arêtes → disciplines ====== -->
    <section class="section onav" id="onav" aria-label="Les disciplines par l’octogone">
      <div class="wrap">
        <div class="onav__grid">
          <div class="onav__stage" data-reveal>
            <!-- LA FENETRE. L’octogone ne montrait rien : huit traits gris et du
                 vide, sur le plus gros objet de la page la plus vue. Il montre
                 desormais la salle — la photo de la discipline choisie remplit
                 la forme, le filaire reste par-dessus. On regarde DANS
                 l’octogone, ce qui est exactement ce qu’on vient chercher. -->
