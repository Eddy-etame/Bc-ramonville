<body data-page="plannings">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">
    <header class="phero" aria-label="Le planning">
      <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div><div class="sky__moon"></div></div>
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Fil d'ariane"><a href="/">Accueil</a> / <span>Planning</span></nav>
        <h1 class="display phero__title"><span class="reveal-mask"><span>La semaine,</span></span><span class="reveal-mask"><span class="tint">côté par côté.</span></span></h1>
        <p class="lead phero__lead" data-reveal>La grille officielle de la rentrée, filtrable par famille. Une variante d'été. Et les posters en couleur, cliquables plein format. Clique un cours pour ouvrir sa discipline.</p>
        <!-- l'objet propre à ce hero (page.js → pheroMeta) -->
        <div class="phero__meta" id="phero-meta" data-reveal-group aria-label="Ce qui se passe maintenant à la salle"></div>
      </div>
    </header>

    <section class="section" aria-label="La grille des cours">
      <div class="wrap">
        <div class="plan__tabs" id="plan-tabs" role="group" aria-label="Choisir la période">
          <button class="plan__tab is-on" data-mode="rentree" type="button" aria-pressed="true">Rentrée</button>
          <button class="plan__tab" data-mode="ete" type="button" aria-pressed="false">Cours d'été</button>
        </div>
        <!-- Repli sans-JS SANS millésime : le libellé de saison passe par
             SEASON_LABEL (data.js), injecté par page.js à l'hydratation.
             Un millésime en dur ici = seconde source de vérité (standards §4). -->
        <!-- Repli sans JS : page.js réécrit cette ligne (RENTREE_NOTE). Les
             deux disent la même chose de la même façon, exprès — c'est la
             même ligne à l'écran, pas deux formules concurrentes. -->
        <p class="plan__note" id="plan-note">Planning complet. En arrivant, pense à émarger sur le GPS : c'est obligatoire pour chaque cours.</p>
        <div class="famfilter" id="plan-filter" role="group" aria-label="Filtrer par famille"></div>
        <div class="gridwrap">
          <table class="grid" id="grid" aria-label="Grille des cours de la semaine"></table>
        </div>
        <!-- la signalétique de la grille, enfin écrite (page.js → GRID_LEGEND) -->
        <div class="grid__legend" id="grid-legend" aria-label="Légende de la grille"></div>

        <!-- L'ÉTÉ a sa propre forme : deux cours, tous les deux le lundi.
             Rendus dans la grille à six colonnes, ils laissaient dix cases
             vides sur douze — une page qui semblait cassée alors que la salle
             lève simplement le pied. Bloc masqué tant qu'on est en rentrée. -->
        <div class="ete" id="ete" hidden></div>

        <div class="posters" id="posters" aria-label="Posters officiels"></div>
      </div>
    </section>

    <!-- ================= LE RYTHME DE LA SEMAINE ==================== -->
    <!-- Même source que la grille (SCHEDULE), lue autrement : le poids de
         chaque jour, le partage midi/soir. Tout est compté, rien n'est écrit
         à la main — si le planning bouge, ce bloc bouge avec lui. -->
    <section class="section" style="background:var(--void);border-block:1px solid var(--line)" aria-label="Le rythme de la semaine">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">La semaine, en poids</span>
          <h2 class="display"><span class="reveal-mask"><span>Quand la salle</span></span><span class="reveal-mask"><span class="tint">est pleine.</span></span></h2>
          <p class="muted">La même grille, comptée. De quoi choisir ton créneau selon ce que tu cherches : du monde, ou de la place.</p>
        </div>
        <div class="rythme" id="rythme"></div>
      </div>
    </section>

    <section class="ctaband" aria-label="Réserver un créneau">
      <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div></div>
      <div class="ctaband__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>Il y a un cours ce soir</span>
        <h2 class="display"><span class="reveal-mask"><span>Choisis ton soir.</span></span></h2>
        <p class="lead" data-reveal>Le planning est réel. Le dehors aussi. Gants et bandes prêtés, tu montes sur le plateau.</p>
        <div class="ctaband__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver l'essai · 10€</span></a>
          <a class="btn btn--ghost" data-magnetic href="/tarifs/"><span>Voir les tarifs</span></a>
        </div>
      </div>
    </section>
  </main>

