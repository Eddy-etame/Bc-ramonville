          <div class="practical__cell"><span class="fk">Horaires</span><span class="fv">Lun – Sam · 10h – 21h30</span></div>
          <div class="practical__cell"><span class="fk">Téléphone</span><span class="fv"><a href="tel:+33562244682">05 62 24 46 82</a></span></div>
          <div class="practical__cell"><span class="fk">Métro</span><span class="fv">Ligne B · terminus Ramonville</span></div>
          <div class="practical__cell"><span class="fk">Bus</span><span class="fv">Arrêt Ramonville Sud</span></div>
          <div class="practical__cell practical__cell--wide"><span class="fk">En salle</span><span class="fv">Accès libre muscu/cardio 6 j/7</span></div>
        </div>
      </div>
    </section>

    <!-- ========================= LE RÉSEAU ========================= -->
