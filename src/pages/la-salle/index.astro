<body data-page="la-salle">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">
    <!-- ============================ HERO ============================ -->
    <header class="phero" aria-label="La salle">
      <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div><div class="sky__moon"></div></div>
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Fil d’ariane"><a href="/">Accueil</a> / <span>La salle</span></nav>
        <h1 class="display phero__title"><span class="reveal-mask"><span>Le tour</span></span><span class="reveal-mask"><span class="tint">de la salle.</span></span></h1>
        <!-- le rail de chiffres — rempli depuis STATS (data.js), compteurs (brief §5) -->
        <div class="prail" id="prail" data-reveal-group aria-label="Le plateau en chiffres"></div>
      </div>
    </header>

    <!-- ================= LE DIFFÉRENCIATEUR — DEHORS D’ABORD ============ -->
    <!-- Comme le claim de la home : le dehors n’est pas illustré par une photo
         d’intérieur. Le fond est le ciel réel de Ramonville (sky.js). -->
    <section class="dehors" aria-label="300 m² d’entraînement en extérieur">
      <div class="sky dehors__sky" aria-hidden="true">
        <div class="sky__haze"></div>
        <div class="sky__moon"></div>
      </div>
      <div class="wrap">
        <div class="dehors__inner">
          <span class="eyebrow" data-reveal>Trois cents mètres carrés à l’air libre</span>
          <h2 class="dehors__huge"><span class="reveal-mask"><span>300 m²</span></span><span class="reveal-mask"><span class="tint">plein ciel.</span></span></h2>
        </div>
      </div>
    </section>

    <!-- ============= LE RELEVÉ DU DEHORS — le cadre vivant ============== -->
    <!-- Le différenciateur n’a aucun cliché : les vingt-quatre photos prouvées sont
         toutes prises à couvert. Plutôt qu’une tuile « photo à venir » (un
         trou déguisé), le cadre porte le CIEL RÉEL au-dessus du plateau —
         seule image fidèle d’un extérieur, et vraie à la seconde. Autour, le
         relevé : ce qui est mesuré, et la ligne qu’on n’a pas, assumée. -->
    <section class="section" aria-label="Le relevé du plateau extérieur">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">Ce que 300 m² veulent dire</span>
          <h2 class="display"><span class="reveal-mask"><span>Tu ne peux pas encore le voir.</span></span><span class="reveal-mask"><span class="tint">Tu peux déjà le mesurer.</span></span></h2>
        </div>
        <div class="releve" id="releve"></div>
      </div>
    </section>

    <!-- ==================== LA COUPE — DEUX NIVEAUX ==================== -->
    <section class="section coupe" aria-label="La salle en coupe : deux niveaux">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">La salle, étage par étage</span>
          <h2 class="display"><span class="reveal-mask"><span>Deux niveaux.</span></span><span class="reveal-mask"><span class="tint">Un escalier au milieu.</span></span></h2>
        </div>
        <div class="coupe__build">
          <article class="floor floor--up" data-reveal>
            <span class="floor__lvl" aria-hidden="true">R+1</span>
            <span class="floor__tag">L’étage</span>
            <h3>Muscu · cardio</h3>
            <p>Poids, machines, vélo, rameur. Tu viens y chercher du souffle et de la force. Personne ne t’y attend. Tu montes entre deux cours, ou à la place d’un cours.</p>
            <div class="floor__zones"><span>Charges libres</span><span>Machines</span><span>Cardio</span><span>Accès libre 6 j/7</span></div>
          </article>
          <article class="floor floor--down" data-reveal>
            <span class="floor__lvl" aria-hidden="true">RDC</span>
            <span class="floor__tag">Le rez-de-chaussée, et le dehors</span>
            <h3>Les cours, et l’air libre</h3>
            <p>Le grand ring, les sacs, la cage de 7 m. Puis les 300 m² couverts, dehors. Les vingt-deux cours de la semaine se donnent ici. Du lundi 12h40 au samedi 16h.</p>
            <div class="floor__zones"><span>300 m² extérieurs</span><span>Octogone 7 m</span><span>Grand ring de boxe</span><span>Ligne de sacs</span><span>Espaces libres</span></div>
          </article>
        </div>
        <p class="coupe__foot"><b>Avant chaque cours</b>, tu valides ta présence à l’accueil (émargement GPS). C’est la seule formalité. Elle se fait en arrivant. Elle vaut pour les deux niveaux.</p>
      </div>
    </section>

    <!-- ======================= LES STATIONS ======================== -->
    <section class="section" aria-label="Les stations du plateau">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">Coin par coin</span>
          <h2 class="display"><span class="reveal-mask"><span>La visite en six arrêts, du dehors à l’étage.</span></span></h2>
        </div>
        <div class="stations" id="stations"></div>
      </div>
    </section>

    <!-- ========================= LE CODE =========================== -->
