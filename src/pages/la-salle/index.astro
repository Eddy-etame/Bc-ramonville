  <!-- ===================== L’ASSISTANT, À LA DEMANDE =====================
       L’assistant ne coûte plus rien tant qu’on ne lui parle pas. Il pesait
       17,5 ko de module + 7,6 ko de feuille BLOQUANT LE RENDU, sur les huit
       pages, pour un panneau que la plupart des visiteurs n’ouvriront jamais.
       Rien n’est retiré à l’écran : la pastille est peinte par base.css comme
       avant, et chatbot.css ne décrit que le panneau — qui n’existe pas encore.
       On charge au premier signe d’intention (survol, doigt, tabulation), donc
       avant le clic dans la quasi-totalité des cas ; le clic reste le filet.
       Sans JavaScript, la pastille est toujours le lien tel: d’origine. -->
  <script is:inline>
    (function () {
      var pastille = document.querySelector("a.chatbot");
      if (!pastille) return;
      var venue = null;
      function venir() {
        if (venue) return venue;
        var f = document.createElement("link");
        f.rel = "stylesheet"; f.href = "/assets/css/chatbot.css?v=19";
        document.head.appendChild(f);
        venue = import("/assets/js/chatbot.js?v=19").catch(function () { venue = null; });
        return venue;
      }
      ["pointerenter", "touchstart", "focus"].forEach(function (e) {
        pastille.addEventListener(e, venir, { once: true, passive: true });
      });
      pastille.addEventListener("click", function (e) {
        /* aria-expanded n’est posé que par chatbot.js : sa présence signifie
           que le vrai widget a pris la main et gère déjà ce clic. */
        if (pastille.hasAttribute("aria-expanded")) return;
        e.preventDefault();
        var p = venir();
        if (p) p.then(function () { pastille.click(); });
        else window.location.href = pastille.href;   // le module n’est pas venu : on appelle la salle
      });
    })();
  </script>
  <script is:inline type="module" src="/assets/js/site.js?v=23"></script>
  <script is:inline type="module" src="/assets/js/sky.js?v=19"></script>
  <script is:inline type="module" src="/assets/js/page.js?v=23"></script>

  <!-- Enrichissement PROPRE à la page : le rail de chiffres (STATS) qui
       s’incrémente. page.js rend déjà #stations / #values / #network. -->
  <script is:inline type="module">
    import { STATS } from "/assets/js/data.js?v=22";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const rail = document.getElementById("prail");
    if (rail && STATS) {
      /* Le rail naît avec les VRAIES valeurs (loi n°1). Il rendait « 0 m² »,
         « 0 m », « 0 niveaux » tant que l’animation n’avait pas tourné : sur
         une frame jamais peinte, le visiteur lisait donc trois chiffres FAUX
         sur les trois faits qui portent la salle. Un chiffre faux est pire
         qu’une absence. Le zéro de départ n’est écrit qu’après preuve que la
         boucle d’animation tourne (rAF ci-dessous). */
      /* On lit s.rail, pas s.l : l’accueil et cette page tiraient les mêmes
         quatre légendes de STATS, mot pour mot. Le nombre est le fait et il
         ne bouge pas ; la phrase autour appartient à la page qui la dit —
         ici on est en visite, pas en vitrine. Repli sur s.l si un jour une
         entrée de STATS arrive sans légende de rail. */
      rail.innerHTML = STATS.map((s, i) =>
        `<div class="prail__cell">
           <span class="prail__v" data-v="${s.v}" data-suffix="${s.suffix || ""}" data-raw="${s.raw ? 1 : 0}">${s.v}<small>${s.suffix || ""}</small></span>
           <span class="prail__l">${s.rail || s.l}</span>
         </div>`).join("");

      // pose la valeur finale, sans animation (le dead-man s’en sert)
      const finalize = (elv) => { elv.innerHTML = elv.dataset.v + `<small>${elv.dataset.suffix || ""}</small>`; };
      // compte à rebours vers la vraie valeur, une fois le rail visible
      const count = (elv) => {
        const target = +elv.dataset.v, suffix = elv.dataset.suffix || "";
        if (reduce || elv.dataset.raw === "1") { finalize(elv); return; }
        const dur = 1100; let t0 = null;
        const step = (ts) => {
          if (!t0) t0 = ts;
          const p = Math.min(1, (ts - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          elv.innerHTML = Math.round(target * eased) + `<small>${suffix}</small>`;
          if (p < 1) requestAnimationFrame(step); else finalize(elv);
        };
        requestAnimationFrame(step);
      };
      if ("IntersectionObserver" in window && !reduce) {
        // preuve de vie de la boucle : sans elle, aucun zéro n’est écrit
        requestAnimationFrame(() => rail.querySelectorAll(".prail__v").forEach((elv) => {
          if (elv.dataset.raw !== "1") elv.innerHTML = `0<small>${elv.dataset.suffix || ""}</small>`;
        }));
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { rail.querySelectorAll(".prail__v").forEach(count); io.disconnect(); }
        }), { threshold: 0.4 });
        io.observe(rail);
        // dead-man (loi n°1) : si le rAF est gelé (onglet en fond, ticker figé),
        // on POSE quand même la vraie valeur — jamais un chiffre bloqué à 0.
        setTimeout(() => rail.querySelectorAll(".prail__v").forEach((elv) => {
          if (parseInt(elv.textContent, 10) !== +elv.dataset.v) finalize(elv);
        }), 1800);
      } else {
        rail.querySelectorAll(".prail__v").forEach(count);
      }
      // lier la vie (reveal + touch) aux nœuds fraîchement injectés
      window.BC?.reveal(document);
      window.BC?.touchLife(".floor");
      window.BC?.refresh();
    }
  </script>
