  <!-- Enrichissement PROPRE à la page : le rail de chiffres (STATS) qui
       s'incrémente. page.js rend déjà #stations / #values / #network. -->
  <script is:inline type="module">
    import { STATS } from "/assets/js/data.js?v=6";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const rail = document.getElementById("prail");
    if (rail && STATS) {
      rail.innerHTML = STATS.map((s, i) =>
        `<div class="prail__cell">
           <span class="prail__v" data-v="${s.v}" data-suffix="${s.suffix || ""}" data-raw="${s.raw ? 1 : 0}">0<small>${s.suffix || ""}</small></span>
           <span class="prail__l">${s.l}</span>
         </div>`).join("");

      // pose la valeur finale, sans animation (le dead-man s'en sert)
      const finalize = (elv) => { elv.innerHTML = elv.dataset.v + `<small>${elv.dataset.suffix || ""}</small>`; };
      // compte à rebours vers la vraie valeur, une fois le rail visible
      const count = (elv) => {
        const target = +elv.dataset.v, suffix = elv.dataset.suffix || "";
        if (reduce || elv.dataset.raw === "1") { finalize(elv); return; }
        const dur = 1100; let t0 = null;
        const step = (ts) => {
          if (!t0) t0 = ts;
          const p = Math.min(1, (ts - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          elv.innerHTML = Math.round(target * eased) + `<small>${suffix}</small>`;
          if (p < 1) requestAnimationFrame(step); else finalize(elv);
        };
        requestAnimationFrame(step);
      };
      if ("IntersectionObserver" in window && !reduce) {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { rail.querySelectorAll(".prail__v").forEach(count); io.disconnect(); }
        }), { threshold: 0.4 });
        io.observe(rail);
        // dead-man (loi n°1) : si le rAF est gelé (onglet en fond, ticker figé),
        // on POSE quand même la vraie valeur — jamais un chiffre bloqué à 0.
        setTimeout(() => rail.querySelectorAll(".prail__v").forEach((elv) => {
          if (parseInt(elv.textContent, 10) !== +elv.dataset.v) finalize(elv);
        }), 1800);
      } else {
        rail.querySelectorAll(".prail__v").forEach(count);
      }
      // lier la vie (reveal + touch) aux nœuds fraîchement injectés
      window.BC?.reveal(document);
      window.BC?.touchLife(".floor");
      window.BC?.refresh();
    }
  </script>
