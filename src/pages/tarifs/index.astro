<body data-page="tarifs">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">
    <header class="phero" aria-label="Les tarifs">
      <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div><div class="sky__moon"></div></div>
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Fil d’ariane"><a href="/">Accueil</a> / <span>Tarifs</span></nav>
        <h1 class="display phero__title phero__title--long"><span class="reveal-mask"><span>Un prix. Le ciel compris.</span></span></h1>
        <p class="lead phero__lead" data-reveal>Tu veux savoir combien. Et si c’est bien ce que tu paieras. Les deux réponses sont ici. Toutes les formules sont écrites en entier, avec ce qu’elles contiennent. Rien ne se découvre au comptoir.</p>
        <!-- l’objet propre à ce hero (page.js → pheroMeta) -->
        <!-- LES TROIS PRIX SONT DANS LE HTML.
             Ce bandeau arrivait vide et se remplissait en JavaScript : 67 px
             qui apparaissaient d’un coup sous le chapeau et poussaient toute
             la page des formules vers le bas. C’était, de loin, le plus gros
             décalage du site (0,621 mesuré en 4G bridée) — et il tombait sur
             la page qui doit inspirer le plus confiance. Trois prix fixes,
             lus de TARIFS et PROMOS au build : la même source que le reste
             de la page, écrite une seule fois dans data.js. pheroMeta() voit
             le bandeau déjà rempli et le laisse tranquille. -->
        <!-- ⚠ CE BANDEAU A DÉJÀ MENTI. Il lisait `TARIFS[0]` en pensant y
             trouver l'essai — vrai à l'écriture, faux depuis que les cartes
             ont été réordonnées par l'ordre de vente : `TARIFS[0]` est
             devenu « Offre Rentrée ». La page annonçait donc « 29 € l'essai »
             en haut, « la séance d'essai est à 10 € » plus bas, et un Offer
             JSON-LD à 10 € dans le head : trois prix d'entrée sur une page.
             On cherche désormais la carte PAR SON NOM : un réordonnancement
             ne peut plus changer ce que la page affirme. -->
        <div class="phero__meta" id="phero-meta" data-reveal-group aria-label="Les trois prix">
          <span><b>{(TARIFS.find((t) => /essai/i.test(t.name)) || TARIFS[TARIFS.length - 1]).price}</b> l’essai</span>
          <span><b>{PROMOS.duo.price}</b> {PROMOS.duo.unit}</span>
          <span><b>{PROMOS.saisonOffre.price}</b> {PROMOS.saisonOffre.unit}</span>
        </div>
      </div>
    </header>

    <!-- essai 10€ en premier + duo + saison + école -->
    <section class="section" aria-label="Les formules">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">Les formules</span>
          <h2 class="display"><span class="reveal-mask"><span>Tu viens voir,</span></span><span class="reveal-mask"><span class="tint">ou tu t’installes&nbsp;?</span></span></h2>
          <p class="muted">L’essai, pour te faire une idée. La rentrée, pour quatre semaines. La saison, pour l’année. L’abonnement au mois, si tu ne veux rien signer de long. L’école, pour les enfants dès 3 ans. Et aucune ne se prolonge toute seule.</p>
        </div>
        <div class="tarifs" id="tarifs" data-reveal-group></div>
        <!-- LE PRIX N’EST PAS LE VRAI FREIN, ET CETTE PAGE LE SAIT.
             Dix euros n’arrêtent personne ; ce qui arrête, c’est de ne pas
             savoir ce qui se passe une fois la porte franchie. Le renvoi est
             donc collé aux formules, là où la main hésite. -->
        <p class="muted" data-reveal style="margin-top:1.4rem;font-size:var(--step--1);max-width:62ch">Ce n’est pas le prix qui retient, en général. <a href="/premiere-seance/" style="color:var(--accent)">Voilà comment se passe une première séance</a>. Le déroulé, la tenue, et les trois choses qu’on ne te fera pas faire.</p>
      </div>
    </section>

    <!-- le bloc promos daté -->
    <section class="section" style="background:var(--void);border-block:1px solid var(--line)" aria-label="Les offres de rentrée">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">Les offres</span>
          <h2 class="display"><span class="reveal-mask"><span>À deux, c’est</span></span><span class="reveal-mask"><span class="tint">29 € chacun.</span></span></h2>
          <p class="muted">Chacun paie sa place. 29 € par personne, pas 29 € pour le couple. Venir accompagné ne change rien à la facture. Ça change la première séance. Tu n’es plus le seul à ne rien savoir faire.</p>
        </div>
        <div class="promos" id="promos" data-reveal></div>
        <div class="promo__bonus" id="promo-bonus" data-reveal></div>
      </div>
    </section>

    <!-- avis Google réels -->
    <section class="section" aria-label="Avis Google">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">Avant de sortir ta carte</span>
          <h2 class="display"><span class="reveal-mask"><span>Ils l’ont payée,</span></span><span class="reveal-mask"><span class="tint">cette salle.</span></span></h2>
        </div>
        <div class="reviews__head" id="reviews-head" data-reveal></div>
        <div class="reviews" id="reviews" data-reveal-group></div>
        <p class="muted" data-reveal style="margin-top:1.2rem;font-size:var(--step--1)">Ces trois avis sont recopiés mot pour mot depuis la fiche Google de la salle. Le nom de l’auteur compris. La fiche est publique. Va lire les autres, y compris ceux qu’on n’a pas mis ici.</p>
      </div>
    </section>

    <!-- LES QUESTIONS D’ARGENT, ÉCRITES AVANT LE COMPTOIR.
         Minimes tient un bloc « Les questions d’argent » sur sa page tarifs et
         l’ouvre par « On préfère te les écrire ici que te les faire découvrir
         au comptoir » : sur une page de prix, la peur n’est pas le montant,
         c’est le supplément qu’on découvre après avoir dit oui. Même procédé
