  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type":"Question", "name":"Où se trouve Boxing Center Ramonville ?", "acceptedAnswer":{"@type":"Answer","text":"Au 33 rue des Ormes, 31520 Ramonville-Saint-Agne, dans le sud toulousain — à proximité du terminus du métro (ligne B, Ramonville) et de l'arrêt bus Ramonville Sud."} },
      { "@type":"Question", "name":"C'est vrai qu'on s'entraîne dehors ?", "acceptedAnswer":{"@type":"Answer","text":"Oui. Ramonville est la seule salle du réseau avec 300 m² extérieurs aménagés et protégés des intempéries : on s'entraîne à l'air, sous le ciel, toute l'année. Il y a aussi un octogone de 7 m et un ring de boxe olympique."} },
      { "@type":"Question", "name":"Quelles disciplines peut-on pratiquer ?", "acceptedAnswer":{"@type":"Answer","text":"Boxe anglaise et anglaise loisirs, boxe pieds-poings, grappling, asso MMA dans l'octogone, Boxing Camp, Lady Punch (100 % féminin) et toute l'école enfants du Baby Boxe (3 ans) aux ados 12/16. Un étage muscu/cardio est en accès libre."} },
      { "@type":"Question", "name":"Y a-t-il des cours pour les enfants ?", "acceptedAnswer":{"@type":"Answer","text":"Oui, dès 3 ans : Baby Boxe 3/6 le samedi, éducative 7/11 ans et ados 12/16 ans le mercredi et le samedi après-midi, encadrés par Valentin G."} },
      { "@type":"Question", "name":"Faut-il un niveau pour commencer ?", "acceptedAnswer":{"@type":"Answer","text":"Aucun. La séance d'essai à 10 € donne accès à toutes les disciplines, matériel prêté. La plupart des créneaux — loisirs, camp, pieds-poings — sont ouverts à tous les niveaux."} },
      { "@type":"Question", "name":"Quels sont les horaires ?", "acceptedAnswer":{"@type":"Answer","text":"Du lundi au samedi, de 10h00 à 21h30, accès libre muscu/cardio inclus. Fermé le dimanche. Un émargement GPS est demandé en salle avant chaque cours."} }
    ]
  }
  </script>

