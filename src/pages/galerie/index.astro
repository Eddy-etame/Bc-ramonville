<body data-page="galerie">
  <a class="sr-only" href="#main">Aller au contenu</a>
  <div id="nav"></div>
  <div id="drawer"></div>

  <main id="main">
    <header class="phero" aria-label="La galerie">
      <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div><div class="sky__moon"></div></div>
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Fil d'ariane"><a href="/">Accueil</a> / <span>Galerie</span></nav>
        <h1 class="display phero__title"><span class="reveal-mask"><span>Carnet</span></span><span class="reveal-mask"><span class="tint">de terrain.</span></span></h1>
        <p class="lead phero__lead" data-reveal>Six cadres, une seule salle, aucune image d'agence. Le carnet ne se contente pas de montrer : il dit de quelle zone il parle, et ce qui s'y tient dans la semaine. Au-dessus, les conditions viennent du vrai ciel de Ramonville, pas d'un preset.</p>
        <!-- conditions au tournage : branché sur window.__SKY (sky.js) -->
        <div class="tournage" id="tournage" aria-label="Conditions au-dessus du plateau"></div>
      </div>
    </header>

    <section class="section" aria-label="Les photos">
      <div class="wrap">
        <div class="gallery" id="gallery"></div>
        <!-- le sommaire du carnet : la couverture réelle, zone par zone -->
        <div class="carnet__index" id="carnet-index" data-reveal-group aria-label="Ce que couvre le carnet"></div>
      </div>
    </section>

    <!-- ============== LE CARNET À L'USAGE — six zones, six heures ======
         Cette page portait ici une COPIE intégrale du relevé de /la-salle/ :
         même sur-titre, même titre, même phrase-thèse, mêmes cinq cartes de
         mesure, même signature — 149 mots sur 358 empruntés à une autre page.
         Le relevé est rendu à son propriétaire. Le carnet dit désormais ce que
         lui seul peut dire : à quoi sert chacun des six lieux photographiés,
         et quand — recompté sur le planning officiel à chaque ouverture. -->
    <section class="section" aria-label="Ce qui se tient dans chaque zone photographiée">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">Le carnet à l'usage</span>
          <h2 class="display"><span class="reveal-mask"><span>Six lieux,</span></span><span class="reveal-mask"><span class="tint">et l'heure qui va avec.</span></span></h2>
          <p class="muted">Un carnet de terrain ne collectionne pas des vues : il note où il était et ce qui s'y tenait. Chaque cadre est donc rendu au planning de la rentrée.</p>
        </div>
        <div class="zones" id="carnet-usage" data-reveal-group></div>
      </div>
    </section>

    <!-- ==================== LA MÉTHODE DU CARNET ==================== -->
    <section class="section" style="background:var(--void);border-block:1px solid var(--line)" aria-label="La méthode du carnet">
      <div class="wrap">
        <div class="shead" data-reveal>
          <span class="eyebrow">La méthode</span>
          <h2 class="display"><span class="reveal-mask"><span>Trois règles,</span></span><span class="reveal-mask"><span class="tint">tenues sur les six.</span></span></h2>
        </div>
        <div class="regles" id="carnet-methode" data-reveal-group></div>
      </div>
    </section>

    <!-- ===================== LA PAGE BLANCHE ========================
         Ce qui manque au carnet tient en trois lignes et un renvoi. Le relevé
         complet — surface, couverture, ouverture, plafond, cliché — appartient
         à /la-salle/ et n'est pas recopié ici. -->
    <section class="section blanche" aria-label="Ce que le carnet ne montre pas">
      <div class="wrap">
        <div class="blanche__inner" data-reveal>
          <span class="eyebrow">La page blanche</span>
          <h2 class="display"><span class="reveal-mask"><span>Le dehors n'est pas</span></span><span class="reveal-mask"><span class="tint">dans ce carnet.</span></span></h2>
          <p class="lead">Les 300 m² extérieurs sont ce que Ramonville a de plus rare, et c'est la seule zone qu'aucun objectif n'a encore prise. On ne bouche pas ce trou avec un cadre d'intérieur qui y ressemblerait vaguement.</p>
          <p class="muted">Ce qui existe du dehors, ce sont ses mesures et son ciel — arpentés sur la page du plateau, pas rejoués ici.</p>
          <div class="blanche__cta" id="carnet-renvoi"></div>
        </div>
      </div>
    </section>

    <section class="ctaband" aria-label="Venir sur le plateau">
      <div class="sky" aria-hidden="true"><canvas class="sky__stars"></canvas><div class="sky__haze"></div></div>
      <div class="ctaband__inner">
        <span class="eyebrow" style="justify-content:center" data-reveal>La photo ne rend pas tout</span>
        <h2 class="display"><span class="reveal-mask"><span>Le mieux,</span></span><span class="reveal-mask"><span class="tint">c'est en vrai.</span></span></h2>
        <p class="lead" data-reveal>La prochaine photo du carnet, c'est toi. Dix euros, gants prêtés.</p>
        <div class="ctaband__cta" data-reveal>
          <a class="btn btn--primary" data-magnetic href="https://box-plus.vercel.app/seance-essai"><span>Réserver l'essai · 10€</span></a>
          <a class="btn btn--ghost" data-magnetic href="/la-salle/"><span>Voir le plateau</span></a>
        </div>
      </div>
    </section>
  </main>

  <!-- la visionneuse plein cadre -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo agrandie">
    <div class="lightbox__frame">
      <button class="lightbox__close" id="lb-close" type="button">Fermer <span aria-hidden="true">✕</span></button>
      <img id="lb-img" alt="" />
      <div class="lightbox__cap" id="lb-cap"></div>
    </div>
  </div>

  <div id="footer"></div>

  <a class="chatbot" href="tel:+33562244682" aria-label="Une question ? Appelle la salle Boxing Center Ramonville">
    <span class="chatbot__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
    <span class="chatbot__label">Une question&nbsp;? Appelle la salle</span>
  </a>

  <!-- ===================== L'ASSISTANT, À LA DEMANDE =====================
       L'assistant ne coûte plus rien tant qu'on ne lui parle pas. Il pesait
       17,5 ko de module + 7,6 ko de feuille BLOQUANT LE RENDU, sur les huit
       pages, pour un panneau que la plupart des visiteurs n'ouvriront jamais.
       Rien n'est retiré à l'écran : la pastille est peinte par base.css comme
       avant, et chatbot.css ne décrit que le panneau — qui n'existe pas encore.
       On charge au premier signe d'intention (survol, doigt, tabulation), donc
       avant le clic dans la quasi-totalité des cas ; le clic reste le filet.
       Sans JavaScript, la pastille est toujours le lien tel: d'origine. -->
  <script is:inline>
    (function () {
      var pastille = document.querySelector("a.chatbot");
      if (!pastille) return;
      var venue = null;
      function venir() {
        if (venue) return venue;
        var f = document.createElement("link");
        f.rel = "stylesheet"; f.href = "/assets/css/chatbot.css?v=11";
        document.head.appendChild(f);
        venue = import("/assets/js/chatbot.js?v=11").catch(function () { venue = null; });
        return venue;
      }
      ["pointerenter", "touchstart", "focus"].forEach(function (e) {
        pastille.addEventListener(e, venir, { once: true, passive: true });
      });
      pastille.addEventListener("click", function (e) {
        /* aria-expanded n'est posé que par chatbot.js : sa présence signifie
           que le vrai widget a pris la main et gère déjà ce clic. */
        if (pastille.hasAttribute("aria-expanded")) return;
        e.preventDefault();
        var p = venir();
        if (p) p.then(function () { pastille.click(); });
        else window.location.href = pastille.href;   // le module n'est pas venu : on appelle la salle
      });
    })();
  </script>

  <script is:inline type="module" src="/assets/js/site.js?v=11"></script>
  <script is:inline type="module" src="/assets/js/sky.js?v=11"></script>
  <script is:inline type="module" src="/assets/js/page.js?v=11"></script>

  <!-- Enrichissement PROPRE à la page : la bande de conditions au-dessus du
       plateau (ciel réel), le sommaire du carnet et la visionneuse plein
       cadre. page.js a déjà rendu #gallery (légendes par zone + scramble),
       #carnet-usage, #carnet-methode et #carnet-renvoi. -->
  <script is:inline type="module">
    import { GALLERY } from "/assets/js/data.js?v=11";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const root = document.documentElement;

    /* --- conditions au tournage, lues du vrai ciel (window.__SKY) --- */
    const strip = document.getElementById("tournage");
    const SKYLABEL = { clair: "Ciel dégagé", voile: "Ciel voilé", pluie: "Pluie", orage: "Orage" };
    const DAYLABEL = { nuit: "Nuit", crepuscule: "Crépuscule", aube: "Aube", jour: "Jour" };
    function renderCond() {
      if (!strip) return;
      const s = window.__SKY || {};
      const sky = SKYLABEL[s.sky] || "Nuit claire";
      const daypart = DAYLABEL[root.getAttribute("data-daypart")] || "Nuit";
      const hour = (typeof s.hour === "number" ? s.hour : new Date().getHours());
      const temp = (s.tempC != null) ? `${s.tempC}°C` : "hors-ligne · nuit claire";
      strip.innerHTML =
        `<span class="tournage__lead">Au-dessus du plateau</span>
         <span class="cond cond--live"><span class="cond__dot" aria-hidden="true"></span><b>${sky}</b></span>
         <span class="cond">${daypart} · ${String(hour).padStart(2, "0")}h</span>
         <span class="cond">${temp}</span>`;
    }
    renderCond();
    window.addEventListener("sky:change", renderCond);

    /* --- le sommaire du carnet : la couverture réelle, zone par zone ---
       La mosaïque ne contient QUE des clichés : la tuile « reportage à venir »
       qui vivait en septième position se lisait comme une image qui n'avait
       pas chargé. Le sommaire liste donc les six zones couvertes, et rien
       d'autre — ce qui manque a sa propre section, plus bas, en clair. */
    const gallery = document.getElementById("gallery");
    const cix = document.getElementById("carnet-index");
    if (cix) {
      cix.innerHTML = GALLERY.map((g) =>
        `<div class="cix"><b>${g.zone}</b><span>${g.place}</span></div>`).join("");
    }

    /* --- visionneuse plein cadre (délégation : marche quel que soit l'ordre) --- */
    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lb-img");
    const lbCap = document.getElementById("lb-cap");
    const lbClose = document.getElementById("lb-close");
    let lbReturn = null; // élément à re-focaliser à la fermeture (la vignette d'origine)
    const closeLb = () => {
      lb.classList.remove("is-open");
      root.classList.remove("is-locked");
      window.BC?.lenis?.start();
      if (lbReturn) { lbReturn.focus?.(); lbReturn = null; }
    };
    const openLb = (img) => {
      const shot = img.closest(".shot");
      lbReturn = shot || img;
      if (lbReturn) lbReturn.tabIndex = -1; // focalisable par programme pour le retour de focus
      /* data-plein : la vignette peut être une version allégée. Le plan large
         est servi à 1 200 px dans la mosaïque (415 px CSS à l'écran) ; ici, où
         la photo occupe tout le cadre, on va chercher le 1 920 d'origine. Les
         cinq autres clichés n'ont pas de data-plein — leur fichier de grille
         EST déjà le plus grand qui existe, et rien ne change pour eux. */
      lbImg.src = img.dataset.plein || img.currentSrc || img.src;
      lbImg.alt = img.alt || "";
      const cap = shot?.querySelector(".shot__cap b");
      lbCap.innerHTML = cap ? `<b>${cap.textContent}</b>` : "";
      lb.classList.add("is-open");
      root.classList.add("is-locked");
      window.BC?.lenis?.stop();
      lbClose?.focus(); // le focus entre dans la visionneuse (role=dialog aria-modal)
    };
    if (gallery && lb) {
      // la mosaïque ne contient plus que des clichés : plus de garde contre
      // une tuile non cliquable, il n'y en a plus.
      const openFrom = (shot) => {
        if (!shot) return;
        const img = shot.querySelector("img"); if (img) openLb(img);
      };
      gallery.addEventListener("click", (e) => openFrom(e.target.closest(".shot")));
      // la porte d'entrée clavier (les vignettes sont role=button tabindex=0) :
      // Entrée + Espace, comme un vrai bouton. Sans ça la visionneuse — pourtant
      // complète côté sortie — était inatteignable autrement qu'à la souris.
      gallery.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " " && e.key !== "Spacebar") return;
        const shot = e.target.closest(".shot"); if (!shot) return;
        e.preventDefault();  // Espace ne doit pas faire défiler la page
        openFrom(shot);
      });
      lbClose.addEventListener("click", closeLb);
      lb.addEventListener("click", (e) => { if (e.target === lb) closeLb(); });
      addEventListener("keydown", (e) => {
        if (!lb.classList.contains("is-open")) return;
        if (e.key === "Escape") closeLb();
        // piège à focus : le seul élément focalisable de la modale est « Fermer »
        else if (e.key === "Tab") { e.preventDefault(); lbClose?.focus(); }
      });
    }
    window.BC?.refresh();
  </script>
</body>
</html>
