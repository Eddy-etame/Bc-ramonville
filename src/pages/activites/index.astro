  <!-- ===================== L’ASSISTANT, À LA DEMANDE =====================
       L’assistant ne coûte plus rien tant qu’on ne lui parle pas. Il pesait
       17,5 ko de module + 7,6 ko de feuille BLOQUANT LE RENDU, sur les huit
       pages, pour un panneau que la plupart des visiteurs n’ouvriront jamais.
       Rien n’est retiré à l’écran : la pastille est peinte par base.css comme
       avant, et chatbot.css ne décrit que le panneau — qui n’existe pas encore.
       On charge au premier signe d’intention (survol, doigt, tabulation), donc
       avant le clic dans la quasi-totalité des cas ; le clic reste le filet.
       Sans JavaScript, la pastille est toujours le lien tel: d’origine. -->
  <script is:inline>
    (function () {
      var pastille = document.querySelector("a.chatbot");
      if (!pastille) return;
      var venue = null;
      function venir() {
        if (venue) return venue;
        var f = document.createElement("link");
        f.rel = "stylesheet"; f.href = "/assets/css/chatbot.css?v=19";
        document.head.appendChild(f);
        venue = import("/assets/js/chatbot.js?v=19").catch(function () { venue = null; });
        return venue;
      }
      ["pointerenter", "touchstart", "focus"].forEach(function (e) {
        pastille.addEventListener(e, venir, { once: true, passive: true });
      });
      pastille.addEventListener("click", function (e) {
        /* aria-expanded n’est posé que par chatbot.js : sa présence signifie
           que le vrai widget a pris la main et gère déjà ce clic. */
        if (pastille.hasAttribute("aria-expanded")) return;
        e.preventDefault();
        var p = venir();
        if (p) p.then(function () { pastille.click(); });
        else window.location.href = pastille.href;   // le module n’est pas venu : on appelle la salle
      });
    })();
  </script>
  <script is:inline type="module" src="/assets/js/site.js?v=23"></script>
  <script is:inline type="module" src="/assets/js/sky.js?v=19"></script>
  <script is:inline type="module" src="/assets/js/page.js?v=23"></script>

  <!-- Enrichissement PROPRE à la page : le sommaire des 8 côtés + scrollspy.
       page.js a déjà rendu #famfilter et #discs (les fiches ancrées #<key>). -->
  <script is:inline type="module">
    import { DISCIPLINES } from "/assets/js/data.js?v=22";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const idx = document.getElementById("dindex");
    if (idx && DISCIPLINES) {
      // familles ordonnées (le libellé propre au sommaire, l’accès libre en dernier)
      const FAM = [
        ["adulte", "Adultes"], ["feminin", "Féminin"],
        ["mma", "Grappling · MMA"], ["enfant", "École enfants"], ["libre", "Accès libre"],
      ];
      const byEdge = [...DISCIPLINES].sort((a, b) => a.edge - b.edge);
      idx.innerHTML = FAM.map(([fam, label]) => {
        const items = byEdge.filter((d) => d.famille === fam);
        if (!items.length) return "";
        return `<div class="dindex__group"><span class="dindex__gk">${label}</span>${
          items.map((d) => `<a href="#${d.key}" data-key="${d.key}" data-fam="${d.famille}">
            <span class="di-name">${d.name}</span><span class="di-edge">${String(d.edge + 1).padStart(2, "0")}</span></a>`).join("")
        }</div>`;
      }).join("");

      const links = [...idx.querySelectorAll("a")];
      const allChip = document.querySelector('.chip[data-fam="all"]');

      // clic sommaire : on remet le filtre sur « Tout » (cible toujours visible) puis on scrolle
      idx.addEventListener("click", (e) => {
        const a = e.target.closest("a"); if (!a) return;
        e.preventDefault();
        const key = a.dataset.key;
        if (allChip && !allChip.classList.contains("is-on")) allChip.click();
        const el = document.getElementById(key);
        if (el) el.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
        history.replaceState(null, "", "#" + key);
      });

      // le filtre famille estompe aussi les entrées du sommaire hors-cible
      const famfilter = document.getElementById("famfilter");
      if (famfilter) famfilter.addEventListener("click", (e) => {
        const b = e.target.closest(".chip"); if (!b) return;
        const fam = b.dataset.fam;
        links.forEach((a) => a.classList.toggle("is-dim", fam !== "all" && a.dataset.fam !== fam));
      });

      // scrollspy : surligne la discipline au centre du viewport
      if ("IntersectionObserver" in window) {
        const spy = new IntersectionObserver((es) => {
          es.forEach((e) => {
            if (!e.isIntersecting) return;
            const key = e.target.id;
            links.forEach((a) => a.classList.toggle("is-active", a.dataset.key === key));
          });
        }, { rootMargin: "-45% 0px -45% 0px", threshold: 0 });
        document.querySelectorAll(".disc").forEach((d) => spy.observe(d));
      }
      window.BC?.reveal(document);
      window.BC?.refresh();
    }
  </script>
</body>
