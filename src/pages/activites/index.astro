    <span class="chatbot__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M9.2 3.2h5.6l3.6 3.6v5.6l-2.6 2.6.8 2.9a.5.5 0 0 1-.72.57L12.1 16.6H9.2l-3.6-3.6V6.8Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"/><circle cx="9.7" cy="11" r="1.25" fill="currentColor" stroke="none"/><circle cx="14.3" cy="11" r="1.25" fill="currentColor" stroke="none"/></svg></span>
