  <!-- ===================== L’ASSISTANT, À LA DEMANDE =====================
       L’assistant ne coûte plus rien tant qu’on ne lui parle pas. Il pesait
       17,5 ko de module + 7,6 ko de feuille BLOQUANT LE RENDU, sur les huit
       pages, pour un panneau que la plupart des visiteurs n’ouvriront jamais.
       Rien n’est retiré à l’écran : la pastille est peinte par base.css comme
       avant, et chatbot.css ne décrit que le panneau — qui n’existe pas encore.
       On charge au premier signe d’intention (survol, doigt, tabulation), donc
       avant le clic dans la quasi-totalité des cas ; le clic reste le filet.
       Sans JavaScript, la pastille est toujours le lien tel: d’origine. -->
  <script is:inline>
    (function () {
      var pastille = document.querySelector("a.chatbot");
      if (!pastille) return;
      var venue = null;
      function venir() {
        if (venue) return venue;
        var f = document.createElement("link");
        f.rel = "stylesheet"; f.href = "/assets/css/chatbot.css?v=19";
        document.head.appendChild(f);
        venue = import("/assets/js/chatbot.js?v=19").catch(function () { venue = null; });
        return venue;
      }
      ["pointerenter", "touchstart", "focus"].forEach(function (e) {
        pastille.addEventListener(e, venir, { once: true, passive: true });
      });
      pastille.addEventListener("click", function (e) {
        /* aria-expanded n’est posé que par chatbot.js : sa présence signifie
           que le vrai widget a pris la main et gère déjà ce clic. */
        if (pastille.hasAttribute("aria-expanded")) return;
        e.preventDefault();
        var p = venir();
        if (p) p.then(function () { pastille.click(); });
        else window.location.href = pastille.href;   // le module n’est pas venu : on appelle la salle
      });
    })();
  </script>

  <script is:inline type="module" src="/assets/js/site.js?v=19"></script>
  <script is:inline type="module" src="/assets/js/sky.js?v=19"></script>
  <script is:inline type="module" src="/assets/js/page.js?v=19"></script>

  <!-- Rendu PROPRE à la page : le roster + les vrais créneaux de chacun,
       dérivés du planning officiel (SCHEDULE). Loi coach respectée : photo
       prouvée → media ; sinon tuile nom. #coachroster ≠ #coachs → page.js
       n’intervient pas. -->
  <script is:inline type="module">
    import { COACHES, SCHEDULE, DAYS } from "/assets/js/data.js?v=19";
    const box = document.getElementById("coachroster");
    if (box && COACHES) {
      const dayIx = (d) => DAYS.indexOf(d);
      // regroupe les créneaux du planning par coach (nom ≡ SCHEDULE.coach)
      /* `planning` : la cle du planning quand elle differe du nom affiche.
         Valentin s'appelle Guth (son visuel officiel le dit) ; le poster
         de la rentree ecrit « Valentin Guth ». On corrige l'affichage sans
         toucher au planning. */
      const slotsFor = (c) => SCHEDULE
        .filter((s) => s.coach === (c.planning || c.name))
        .sort((a, b) => (dayIx(a.day) - dayIx(b.day)) || a.start.localeCompare(b.start));

      box.innerHTML = COACHES.map((c) => {
        const slots = slotsFor(c);
        /* LA PLAQUE — le filet, plus le cas courant.
           Deux fiches sur quatre n'avaient pas de portrait : elles
           portaient une plaque gravée, dans l'identité nuit/argent de la
           salle, plutôt qu'une photo annoncée pour plus tard — une excuse
           datée, qui vieillit chaque jour. Les CINQ coachs de la saison
           2026/2027 ont leur visage depuis le 24/08 : ce chemin ne se
           déclenche plus. Il reste, parce qu'un coach peut arriver avant
           sa photo — et ce jour-là on veut une plaque, pas un visage
           d'emprunt pris dans une banque d'images. aria-hidden : le nom
           et le rôle sont déjà annoncés juste dessous. */
        const face = c.img
          ? `<div class="coach__face media"${c.ratio ? ` style="aspect-ratio:${c.ratio}"` : ""} data-img="${c.img}" data-label="" data-alt="Visuel officiel 2026/2027 de ${c.name}, ${c.tag.toLowerCase()} au Boxing Center Ramonville"></div>`
          : `<div class="coach__face coach__face--plaque" aria-hidden="true">
               <span class="plaque__rule"></span>
               <span class="plaque__name">${c.name}</span>
               <span class="plaque__role">${c.tag}</span>
             </div>`;
        const slotHtml = slots.length
          ? `<div class="coach__slots">${slots.map((s) =>
              `<div class="slotline"><span class="d">${s.day}</span><span class="t">${s.start}</span><span class="c">${s.cours}</span></div>`).join("")}</div>`
          : "";
        return `<article class="coach ${c.pillar ? "coach--pillar" : ""}">
          ${face}
          <div class="coach__body">
            <span class="coach__tag">${c.tag}</span>
            <h3>${c.name}</h3>
            <span class="coach__role">${c.role}</span>
            ${c.disciplines?.length ? `<ul class="coach__disc">${c.disciplines.map((d) => `<li>${d}</li>`).join("")}</ul>` : ""}
            <p>${c.note}</p>
            ${c.parcours ? `<p class="coach__parcours"><span>Parcours</span>${c.parcours}</p>` : ""}
            ${c.approche?.length ? `<div class="coach__bloc"><span class="coach__k">Son approche</span><ul>${c.approche.map((a) => `<li>${a}</li>`).join("")}</ul></div>` : ""}
            <div class="coach__pied">
              ${c.qualites?.length ? `<div class="coach__bloc"><span class="coach__k">Ses qualités</span><ul class="coach__inline">${c.qualites.map((q) => `<li>${q}</li>`).join("")}</ul></div>` : ""}
              ${c.formation?.length ? `<div class="coach__bloc"><span class="coach__k">Formation</span><ul class="coach__inline">${c.formation.map((f) => `<li>${f}</li>`).join("")}</ul></div>` : ""}
            </div>
            ${c.devise ? `<blockquote class="coach__devise">${c.devise}</blockquote>` : ""}
            <span class="coach__count"><b>${slots.length}</b><span>créneaux / semaine</span></span>
            ${slotHtml}
          </div>
        </article>`;
      }).join("");

      // hydrate les photos (.media), lie la vie aux fiches injectées
      window.BC?.media(document);
      window.BC?.reveal(document);
      window.BC?.touchLife(".coach");
      window.BC?.refresh();
    }
  </script>
</body>
</html>
